import React, { useEffect, useState, useMemo } from 'react';
import apiClient from './api/client';
import { Button } from './components/ui/Button';
import { Card } from './components/ui/Card';
import { Badge } from './components/ui/Badge';
import { MatchScoreRing } from './components/ui/MatchScoreRing';
import { ProgressBar } from './components/ui/ProgressBar';
import { Skeleton } from './components/ui/Skeleton';
import { useToast } from './components/ui/ToastContext';
import { Sparkles, Briefcase, Bookmark, ClipboardList, MapPin, Save, Plus, XCircle, GitCompare, Search } from 'lucide-react';

export default function App() {
  const [tab, setTab] = useState('dashboard');
  const [profile, setProfile] = useState(null);
  const [internships, setInternships] = useState([]);
  const [recs, setRecs] = useState([]);
  const [selectedId, setSelectedId] = useState(null);
  const [activeMatch, setActiveMatch] = useState(null);
  const [savedIds, setSavedIds] = useState(['intern-101']);
  const [search, setSearch] = useState('');
  const [newSkill, setNewSkill] = useState('');
  const [loading, setLoading] = useState(true);
  const [resumeFile, setResumeFile] = useState(null);
  const [uploadingResume, setUploadingResume] = useState(false);
  const [resumeMessage, setResumeMessage] = useState('');
  const { addToast } = useToast();

  const loadData = async () => {
    setLoading(true);
    try {
      const [pRes, iRes, rRes] = await Promise.all([
        apiClient.get('/students/me'),
        apiClient.get('/internships'),
        apiClient.get('/matches/recommendations')
      ]);
      setProfile(pRes.data); setInternships(iRes.data); setRecs(rRes.data);
      if (iRes.data.length > 0) {
        setSelectedId(iRes.data[0].id);
        setActiveMatch(rRes.data.find(r => r.internshipId === iRes.data[0].id) || rRes.data[0]);
      }
    } catch (e) { addToast(e.message, 'error'); } finally { setLoading(false); }
  };

  useEffect(() => { loadData(); }, []);

  const matchMap = useMemo(() => {
    const m = {}; recs.forEach(r => { m[r.internshipId] = r; }); return m;
  }, [recs]);

  const inspectRole = async (id) => {
    setSelectedId(id);
    try {
      const res = await apiClient.post('/matches/analyze/' + id);
      setActiveMatch(res.data); setTab('analysis');
    } catch (e) { addToast(e.message, 'error'); }
  };

  const saveProfile = async (e) => {
    e.preventDefault();
    try {
      const res = await apiClient.put('/students/me', profile);
      setProfile(res.data);
      const rRes = await apiClient.get('/matches/recommendations');
      setRecs(rRes.data);
      addToast('Profile saved & MongoDB matches recalculated!', 'success');
    } catch (err) { addToast(err.message, 'error'); }
  };

    const uploadResume = async (e) => {
    e.preventDefault();

    if (!resumeFile) {
      setResumeMessage("Please select a PDF file.");
      return;
    }

    if (!resumeFile.name.toLowerCase().endsWith(".pdf")) {
      setResumeMessage("Only PDF files are allowed.");
      return;
    }

    if (resumeFile.size > 5 * 1024 * 1024) {
      setResumeMessage("PDF must be 5 MB or smaller.");
      return;
    }

    setUploadingResume(true);
    setResumeMessage("");

    try {
      const formData = new FormData();
      formData.append("file", resumeFile);

      const response = await apiClient.post(
        "/resumes/upload",
        formData
      );

      setResumeMessage(
        response.data?.message || "Resume uploaded successfully."
      );
      setResumeFile(null);

      const input = document.getElementById("resume-file-input");
      if (input) input.value = "";
    } catch (error) {
      setResumeMessage(
        error.response?.data?.message ||
        error.message ||
        "Resume upload failed."
      );
    } finally {
      setUploadingResume(false);
    }
  };
  const addSkill = () => {
    if (!newSkill.trim()) return;
    setProfile({ ...profile, skills: [...(profile.skills || []), { name: newSkill.trim(), category: 'TECH', proficiency: 'INTERMEDIATE' }] });
    setNewSkill(''); addToast('Skill added! Click Save Profile to recalculate.', 'success');
  };

  const removeSkill = (name) => {
    setProfile({ ...profile, skills: profile.skills.filter(s => s.name !== name) });
  };

  const toggleSave = (id) => {
    setSavedIds(prev => prev.includes(id) ? prev.filter(x => x !== id) : [...prev, id]);
    addToast('Updated Saved Internships', 'success');
  };

  const currentIntern = internships.find(i => i.id === selectedId) || internships[0];

  return (
    <div className='min-h-screen bg-slate-50 text-slate-900 flex flex-col font-sans'>
      <header className='bg-slate-900 text-white px-6 py-4 flex flex-wrap justify-between items-center gap-4 shadow-md'>
        <div className='flex items-center gap-3'>
          <div className='w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center font-bold'><Sparkles className='w-5 h-5' /></div>
          <div>
            <h1 className='text-base font-extrabold tracking-tight'>Smart Internship Matcher</h1>
            <p className='text-[11px] text-slate-400'>Explainable AI Eligibility & Skill-Gap Platform</p>
          </div>
        </div>
        <nav className='flex flex-wrap gap-2'>
          {[['dashboard','Dashboard'],['discovery','Find Internships'],['analysis','Match Analysis'],['compare','Compare'],['profile','My Profile']].map(([k,label]) => (
            <Button key={k} variant={tab === k ? 'primary' : 'ghost'} size='sm' onClick={() => setTab(k)} className={tab !== k ? 'text-slate-300 hover:text-white hover:bg-slate-800' : ''}>{label}</Button>
          ))}
        </nav>
      </header>

      <main className='flex-1 max-w-7xl w-full mx-auto p-6 space-y-6'>
        {loading ? <Skeleton className='h-64 w-full' /> : (
          <>
            {tab === 'dashboard' && (
              <div className='space-y-6'>
                <Card className='p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-slate-900 text-white border-0'>
                  <div>
                    <Badge variant='indigo'>Live MongoDB Profile</Badge>
                    <h2 className='text-2xl font-extrabold mt-2'>Welcome back, {profile?.fullName}</h2>
                    <p className='text-xs text-slate-300 mt-1'>{profile?.headline}</p>
                  </div>
                  <div className='flex gap-3'>
                    <Button variant='primary' size='sm' onClick={() => setTab('discovery')}>Explore Internships</Button>
                    <Button variant='outline' size='sm' onClick={() => setTab('profile')}>Update Skills</Button>
                  </div>
                </Card>
                <div className='grid grid-cols-1 md:grid-cols-3 gap-5'>
                  <Card className='p-5 flex justify-between items-center'><div><p className='text-xs font-bold uppercase text-slate-400'>Internships Analyzed</p><p className='text-3xl font-extrabold mt-1'>{recs.length}</p></div><Briefcase className='w-8 h-8 text-indigo-600' /></Card>
                  <Card className='p-5 flex justify-between items-center'><div><p className='text-xs font-bold uppercase text-slate-400'>Strong Matches (â‰¥80%)</p><p className='text-3xl font-extrabold text-emerald-600 mt-1'>{recs.filter(r => r.overallScore >= 80).length}</p></div><Sparkles className='w-8 h-8 text-emerald-600' /></Card>
                  <Card className='p-5 flex justify-between items-center'><div><p className='text-xs font-bold uppercase text-slate-400'>Saved Opportunities</p><p className='text-3xl font-extrabold text-indigo-600 mt-1'>{savedIds.length}</p></div><Bookmark className='w-8 h-8 text-indigo-600' /></Card>
                </div>
                <h3 className='text-base font-bold text-slate-900'>Recommended Opportunities Based on Your Profile</h3>
                <div className='grid grid-cols-1 md:grid-cols-2 gap-5'>
                  {recs.map(r => {
                    const intern = internships.find(i => i.id === r.internshipId) || {};
                    return (
                      <Card key={r.id} hover className='p-6 flex flex-col justify-between space-y-4'>
                        <div className='flex justify-between items-start gap-4'>
                          <div>
                            <span className='text-xs font-bold text-indigo-600 uppercase'>{intern.company}</span>
                            <h4 className='text-base font-extrabold text-slate-900 mt-0.5'>{intern.title}</h4>
                            <p className='text-xs text-slate-500 mt-1'>{intern.description}</p>
                          </div>
                          <MatchScoreRing score={r.overallScore} size={84} />
                        </div>
                        <div className='flex flex-wrap gap-1.5'>
                          {r.matchedSkills?.slice(0,5).map(s => <Badge key={s} variant='success'>{s}</Badge>)}
                          {r.missingMandatorySkills?.map(s => <Badge key={s} variant='danger'>Missing: {s}</Badge>)}
                        </div>
                        <div className='flex justify-between items-center pt-3 border-t border-slate-100'>
                          <Badge variant={r.eligibilityStatus === 'MEETS_SPECIFIED_MANDATORY_REQUIREMENTS' ? 'success' : 'danger'} showIcon>{r.eligibilityStatus === 'MEETS_SPECIFIED_MANDATORY_REQUIREMENTS' ? 'Eligible' : 'Ineligible'}</Badge>
                          <Button variant='primary' size='sm' onClick={() => inspectRole(intern.id)}>View Full Breakdown</Button>
                        </div>
                      </Card>
                    );
                  })}
                </div>
              </div>
            )}

            {tab === 'discovery' && (
              <div className='space-y-6'>
                <Card className='p-4 flex items-center gap-3'>
                  <Search className='w-5 h-5 text-slate-400' />
                  <input value={search} onChange={e => setSearch(e.target.value)} placeholder='Filter by title, company, or skill (e.g. Java, React, Docker)...' className='w-full text-sm focus:outline-none' />
                </Card>
                <div className='grid grid-cols-1 md:grid-cols-2 gap-5'>
                  {internships.filter(i => !search || i.title.toLowerCase().includes(search.toLowerCase()) || i.requiredSkills?.some(s => s.toLowerCase().includes(search.toLowerCase()))).map(i => {
                    const m = matchMap[i.id] || { overallScore: 0 };
                    return (
                      <Card key={i.id} hover className='p-6 space-y-4 flex flex-col justify-between'>
                        <div>
                          <div className='flex justify-between items-start'>
                            <div><p className='text-xs font-bold text-indigo-600'>{i.company}</p><h4 className='text-base font-bold text-slate-900'>{i.title}</h4></div>
                            <span className='font-mono text-lg font-extrabold text-indigo-600 bg-indigo-50 px-3 py-1 rounded-xl'>{m.overallScore}%</span>
                          </div>
                          <p className='text-xs text-slate-500 mt-2'>{i.description}</p>
                        </div>
                        <div className='flex justify-between items-center pt-3 border-t border-slate-100'>
                          <Button variant='outline' size='sm' onClick={() => toggleSave(i.id)}>{savedIds.includes(i.id) ? 'â˜… Saved' : 'â˜† Save'}</Button>
                          <Button variant='primary' size='sm' onClick={() => inspectRole(i.id)}>Analyze Fit</Button>
                        </div>
                      </Card>
                    );
                  })}
                </div>
              </div>
            )}

            {tab === 'analysis' && activeMatch && (
              <div className='space-y-6'>
                <Card className='p-6 flex flex-col md:flex-row justify-between items-center gap-6'>
                  <div className='flex items-center gap-6'>
                    <MatchScoreRing score={activeMatch.overallScore} size={120} showDisclaimer={true} />
                    <div className='space-y-1'>
                      <Badge variant='indigo'>{currentIntern?.company}</Badge>
                      <h2 className='text-2xl font-extrabold text-slate-900'>{currentIntern?.title}</h2>
                      <p className='text-xs text-slate-500'>{currentIntern?.location} ({currentIntern?.workMode}) â€¢ â‚¹{currentIntern?.stipendPerMonth?.toLocaleString('en-IN')}/mo</p>
                    </div>
                  </div>
                  <Badge variant={activeMatch.eligibilityStatus === 'MEETS_SPECIFIED_MANDATORY_REQUIREMENTS' ? 'success' : 'danger'} showIcon>{activeMatch.eligibilityStatus}</Badge>
                </Card>
                <div className='grid grid-cols-1 lg:grid-cols-2 gap-6'>
                  <Card className='p-6 space-y-4'>
                    <h3 className='text-sm font-bold uppercase tracking-wider text-slate-700'>5-Factor Weighted Score Breakdown</h3>
                    <ProgressBar label='Technical Skills (35%)' score={activeMatch.componentScores?.technicalSkillsScore} color='indigo' />
                    <ProgressBar label='Education Relevance (20%)' score={activeMatch.componentScores?.educationRelevanceScore} color='emerald' />
                    <ProgressBar label='Projects & Experience (20%)' score={activeMatch.componentScores?.projectAndExperienceScore} color='indigo' />
                    <ProgressBar label='Location & Availability (15%)' score={activeMatch.componentScores?.locationAndPreferenceScore} color='emerald' />
                    <ProgressBar label='Certifications & Extras (10%)' score={activeMatch.componentScores?.additionalQualificationsScore} color='amber' />
                  </Card>
                  <Card className='p-6 space-y-4'>
                    <h3 className='text-sm font-bold uppercase tracking-wider text-slate-700'>Skill Gap & Evidence Breakdown</h3>
                    <div><p className='text-xs font-bold text-emerald-700 mb-1.5'>Matched Skills ({activeMatch.matchedSkills?.length})</p><div className='flex flex-wrap gap-1.5'>{activeMatch.matchedSkills?.map(s => <Badge key={s} variant='success'>{s}</Badge>)}</div></div>
                    <div><p className='text-xs font-bold text-rose-700 mb-1.5'>Missing Mandatory Skills ({activeMatch.missingMandatorySkills?.length})</p><div className='flex flex-wrap gap-1.5'>{activeMatch.missingMandatorySkills?.length ? activeMatch.missingMandatorySkills.map(s => <Badge key={s} variant='danger'>{s}</Badge>) : <span className='text-xs text-emerald-600 font-semibold'>None â€” All mandatory skills satisfied!</span>}</div></div>
                    <div><p className='text-xs font-bold text-amber-700 mb-1.5'>Missing Preferred Skills ({activeMatch.missingPreferredSkills?.length})</p><div className='flex flex-wrap gap-1.5'>{activeMatch.missingPreferredSkills?.map(s => <Badge key={s} variant='warning'>{s}</Badge>)}</div></div>
                    <div className='bg-slate-50 p-3.5 rounded-xl border border-slate-200 text-xs text-slate-700 leading-relaxed'><strong>Explanation:</strong> {activeMatch.summaryExplanation}</div>
                  </Card>
                </div>
              </div>
            )}

            {tab === 'compare' && (
              <Card className='p-6 overflow-x-auto'>
                <h2 className='text-lg font-extrabold text-slate-900 mb-4'>Side-by-Side Internship Comparison</h2>
                <table className='w-full text-left border-collapse text-xs'>
                  <thead><tr className='border-b border-slate-200 bg-slate-50'><th className='p-3 font-bold'>Criterion</th>{internships.map(i => <th key={i.id} className='p-3 font-extrabold text-slate-900'>{i.title}<br/><span className='text-indigo-600 font-semibold'>{i.company}</span></th>)}</tr></thead>
                  <tbody className='divide-y divide-slate-200'>
                    <tr><td className='p-3 font-bold'>Overall Match Score</td>{internships.map(i => <td key={i.id} className='p-3 font-mono text-base font-extrabold text-indigo-600'>{matchMap[i.id]?.overallScore}%</td>)}</tr>
                    <tr><td className='p-3 font-bold'>Mandatory Eligibility</td>{internships.map(i => <td key={i.id} className='p-3'><Badge variant='success'>Meets Requirements</Badge></td>)}</tr>
                    <tr><td className='p-3 font-bold'>Matched Skills</td>{internships.map(i => <td key={i.id} className='p-3 text-emerald-700 font-medium'>{matchMap[i.id]?.matchedSkills?.join(', ')}</td>)}</tr>
                    <tr><td className='p-3 font-bold'>Missing Mandatory Skills</td>{internships.map(i => <td key={i.id} className='p-3 text-rose-600 font-semibold'>{matchMap[i.id]?.missingMandatorySkills?.join(', ') || 'None'}</td>)}</tr>
                    <tr><td className='p-3 font-bold'>Location & Stipend</td>{internships.map(i => <td key={i.id} className='p-3'>{i.location} ({i.workMode}) â€¢ â‚¹{i.stipendPerMonth}/mo</td>)}</tr>
                  </tbody>
                </table>
              </Card>
            )}

            {tab === 'profile' && profile && (
              <Card className='p-6 max-w-3xl mx-auto'>
                <form onSubmit={saveProfile} className='space-y-5'>
                  <div className='flex justify-between items-center border-b border-slate-100 pb-3'>
                    <h2 className='text-lg font-extrabold'>Edit Student Profile (Live MongoDB Sync)</h2>
                    <Button variant='primary' size='sm' type='submit' icon={Save}>Save & Recalculate</Button>
                  </div>
                  <div className='grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs'>
                    <div><label className='font-bold block mb-1'>Full Name</label><input value={profile.fullName || ''} onChange={e => setProfile({...profile, fullName: e.target.value})} className='w-full border border-slate-300 rounded-lg p-2' /></div>
                    <div><label className='font-bold block mb-1'>Current Location</label><input value={profile.currentLocation || ''} onChange={e => setProfile({...profile, currentLocation: e.target.value})} className='w-full border border-slate-300 rounded-lg p-2' /></div>
                  </div>
                  <div className='text-xs'>
                    <label className='font-bold block mb-2'>Skills (Try adding Docker to boost FinLedger Backend score to 100%!)</label>
                    <div className='flex flex-wrap gap-1.5 mb-3'>
                      {profile.skills?.map(s => (
                        <span key={s.name} className='inline-flex items-center gap-1 px-2.5 py-1 bg-slate-100 border border-slate-300 rounded-lg font-semibold'>
                          {s.name} <button type='button' onClick={() => removeSkill(s.name)} className='text-rose-500 font-bold ml-1'>Ã—</button>
                        </span>
                      ))}
                    </div>
                    <div className='flex gap-2 max-w-sm'>
                      <input value={newSkill} onChange={e => setNewSkill(e.target.value)} placeholder='e.g. Docker' className='flex-1 border border-slate-300 rounded-lg p-2' />
                      <Button type='button' variant='secondary' size='sm' onClick={addSkill} icon={Plus}>Add Skill</Button>
                    </div>
                  </div>
                </form>
              </Card>
            )}
          </>
        )}
      </main>
    </div>
  );
}

